# Netlify Database production va deploy previewda Netlify tomonidan avtomatik ulanadi.
# Lokal ishga tushirishda `@netlify/vite-plugin` / `netlify dev` lokal Postgresni avtomatik ta'minlaydi.
# Tashqi Postgres ishlatmoqchi bo'lsangiz quyidagini faollashtiring:
# NETLIFY_DB_URL=postgres://postgres:postgres@localhost:5432/finflow_local

# Sessiya tokenlarini HMAC imzolash uchun maxfiy kalit (kamida 32 belgi)
AUTH_SECRET=replace-with-a-long-random-secret-key

VITE_APP_NAME=FinFlow
VITE_DEFAULT_CURRENCY=UZS
